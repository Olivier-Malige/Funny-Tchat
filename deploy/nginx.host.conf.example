# Use this if Nginx already runs on the VPS (ports 80/443 taken).
# 1. Point DNS to the VPS
# 2. Start the app only: docker compose up -d --build
#    with ports: "127.0.0.1:3000:3000"
# 3. Copy this file into sites-available and enable it
# 4. Issue a certificate (certbot) then reload nginx

server {
    listen 80;
    listen [::]:80;
    server_name tchat.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name tchat.example.com;

    ssl_certificate     /etc/letsencrypt/live/tchat.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tchat.example.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }
}
