# --- Local (docker compose / npm run dev) ---
PORT=3000
CORS_ORIGIN=*

# --- Production VPS (docker compose -f docker-compose.prod.yml) ---
# DNS A record must point this hostname to the VPS public IP.
# CORS_ORIGIN must be the public HTTPS origin (never * in production).
DOMAIN=tchat.example.com
CORS_ORIGIN=https://tchat.example.com
ACME_EMAIL=you@example.com

# Server activity log file (connect / join / message). Default: ./logs
# LOG_DIR=./logs
