{
  "name": "funny-tchat",
  "version": "1.1.0",
  "private": true,
  "description": "Real-time chat with no authentication — end-of-training React project, modernized.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "animate.css": "^4.1.1",
    "bulma": "^0.9.4",
    "emoji-mart": "^5.6.0",
    "express": "^4.21.2",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-color": "^2.19.3",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.1.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "sass": "^1.85.1",
    "vite": "^8.2.1"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"vite\"",
    "dev:server": "node --watch server/server.js",
    "start": "vite",
    "start:server": "node server/server.js",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src server",
    "clean": "rm -rf dist"
  }
}
